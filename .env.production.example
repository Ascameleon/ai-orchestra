# Copy to .env.production and replace every placeholder. Never commit .env.production.
# Generate a unique API key, e.g. with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ORCHESTRA_API_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
ORCHESTRA_REQUIRE_API_KEY=true
ORCHESTRA_PROVIDER=gemini
ORCHESTRA_PROVIDER_FALLBACKS=
GEMINI_API_KEY=REPLACE_WITH_YOUR_PROVIDER_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# Optional SDKs. Examples: openai,anthropic,grok or redis. Comma-separate extras as needed.
ORCHESTRA_EXTRAS=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
XAI_API_KEY=
GROK_MODEL=grok-3-mini

# Keep the service loopback-only unless a TLS reverse proxy is configured.
ORCHESTRA_PORT=8000
ORCHESTRA_MAX_INPUT_CHARS=12000
ORCHESTRA_MAX_OUTPUT_TOKENS=512
# Persistent daily call cap (UTC); usage survives restarts. Default limit is 100 calls/day.
# If ORCHESTRA_REDIS_URL is set, Redis takes precedence over this local SQLite budget.
ORCHESTRA_BUDGET_DB=/data/request-budget.sqlite3
ORCHESTRA_REDIS_URL=
ORCHESTRA_MAX_REQUESTS=100
ORCHESTRA_AUDIT_CAPACITY=1000
ORCHESTRA_CIRCUIT_FAILURE_THRESHOLD=3
ORCHESTRA_CIRCUIT_RESET_SECONDS=30
ORCHESTRA_EVIDENCE_ALLOWED_HOSTS=
ORCHESTRA_TASK_ROUTES=
