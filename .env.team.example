# Multi-agent team profile for AI ORCHESTRA. Copy to .env; never commit real keys.
# Live API calls may consume paid quota. Verify provider billing/free quota before enabling.
ORCHESTRA_PROVIDER=gemini
ORCHESTRA_PROVIDER_FALLBACKS=openai,anthropic,grok
# Leave the workbench primary-provider selector blank to use role routing.
ORCHESTRA_TASK_ROUTES=planner=gemini,code=openai,research=gemini,analysis=gemini,writing=anthropic,reviewer=anthropic,writer=anthropic

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
XAI_API_KEY=
GROK_MODEL=grok-3-mini

ORCHESTRA_MAX_INPUT_CHARS=12000
ORCHESTRA_MAX_OUTPUT_TOKENS=1024
ORCHESTRA_MAX_REQUESTS=10
ORCHESTRA_CIRCUIT_FAILURE_THRESHOLD=3
ORCHESTRA_CIRCUIT_RESET_SECONDS=30
ORCHESTRA_API_KEY=
ORCHESTRA_MEMORY_DB=
ORCHESTRA_AUDIT_DB=
