# Copy to .env locally; never commit real credentials.
# Select gemini, openai, anthropic, grok, kimi, deepseek, freellmapi or manus. Optional SDK extras are listed in README.
ORCHESTRA_PROVIDER=gemini
# Optional ordered failover, comma-separated; requires keys and SDK extras for each provider
ORCHESTRA_PROVIDER_FALLBACKS=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
XAI_API_KEY=
GROK_MODEL=grok-3-mini
KIMI_API_KEY=
# Optional alias accepted for the same Moonshot API key:
# MOONSHOT_API_KEY=
KIMI_MODEL=kimi-k2.6
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# FreeLLMAPI local gateway (Android Termux default); keep its unified key server-side.
FREELLMAPI_API_KEY=
FREELLMAPI_BASE_URL=http://127.0.0.1:3001/v1
FREELLMAPI_MODEL=auto
# Manus tasks can consume account credits; leave disabled unless explicitly approved.
MANUS_API_KEY=
MANUS_ALLOW_PAID_CALLS=false
MANUS_ALLOW_AGENT_TOOLS=false
MANUS_AGENT_PROFILE=lite
MANUS_TIMEOUT_SECONDS=300
MANUS_POLL_INTERVAL_SECONDS=2
# Set to a model enabled for your account and quota; provider API calls may be billed.
GEMINI_MODEL=gemini-3.8-flash
ORCHESTRA_MAX_INPUT_CHARS=12000
ORCHESTRA_MAX_OUTPUT_TOKENS=1024
ORCHESTRA_MAX_REQUESTS=100
ORCHESTRA_AUDIT_CAPACITY=1000
ORCHESTRA_CIRCUIT_FAILURE_THRESHOLD=3
ORCHESTRA_CIRCUIT_RESET_SECONDS=30
# Comma-separated DNS hostnames allowed for source fetching; empty disables it.
ORCHESTRA_EVIDENCE_ALLOWED_HOSTS=
# Optional local SQLite file for persistent aggregate provider outcomes only; leave blank to disable.
ORCHESTRA_MEMORY_DB=
# Optional local SQLite file for persistent, bounded audit metadata only; leave blank to disable.
ORCHESTRA_AUDIT_DB=
# Optional: require this header on task/workflow, metrics, audit, provider-health/circuit, and evidence/claim endpoints.
# Set a long random value in the local environment; never commit a real secret.
ORCHESTRA_API_KEY=

# Optional task-aware provider routing; targets must be the primary or a configured fallback.
# ORCHESTRA_TASK_ROUTES=code=openai,research=gemini,writing=anthropic
