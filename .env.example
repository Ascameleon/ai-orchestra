# Copy to .env locally; never commit real credentials.
# Select gemini, openai or anthropic. OpenAI and Anthropic require their optional extras.
ORCHESTRA_PROVIDER=gemini
# Optional ordered failover, comma-separated; requires keys and SDK extras for each provider
ORCHESTRA_PROVIDER_FALLBACKS=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
# Set to a model enabled for your account and current free-tier quota.
GEMINI_MODEL=gemini-2.5-flash
ORCHESTRA_MAX_INPUT_CHARS=12000
ORCHESTRA_MAX_OUTPUT_TOKENS=1024
ORCHESTRA_MAX_REQUESTS=100
ORCHESTRA_AUDIT_CAPACITY=1000
# Optional local SQLite file for persistent aggregate provider outcomes only; leave blank to disable.
ORCHESTRA_MEMORY_DB=
# Optional local SQLite file for persistent, bounded audit metadata only; leave blank to disable.
ORCHESTRA_AUDIT_DB=
# Optional: require this header on /v1/tasks, /v1/workflows/review, /v1/workflows/plan-execute, /metrics, /audit and /providers/health.
# Set a long random value in the local environment; never commit a real secret.
ORCHESTRA_API_KEY=

# Optional task-aware provider routing; targets must be the primary or a configured fallback.
# ORCHESTRA_TASK_ROUTES=code=openai,research=gemini,writing=anthropic
